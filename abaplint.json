{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abaplint/deps",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/SAP-samples/abap-platform-refscen-flight",
      "branch": "ABAP-platform-2025",
      "folder": "/flight",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v758",
    "errorNamespace": "^(Z|Y|LCL_|LCX_|LIF_|TY_|TT_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true
  }
}
