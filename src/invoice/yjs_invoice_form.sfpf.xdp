               <para vAlign="middle"/>
               <value>
                  <date/>
               </value>
               <format>
                  <picture>date{DD MMM YYYY}</picture>
               </format>
               <bind match="dataRef" ref="$.FLIGHT_DATE"/>
            </field>
            <field name="CARRIER_NAME" h="6.5mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                     <margin/>
                  </textEdit>
