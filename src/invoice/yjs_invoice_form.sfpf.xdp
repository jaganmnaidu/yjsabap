               </value>
               <font typeface="Arial" size="9pt" weight="bold"/>
               <margin leftInset="1mm" rightInset="1mm"/>
               <para vAlign="middle"/>
            </draw>
            <?templateDesigner expand 1?></subform>
         <subform name="Row" layout="row">
            <occur min="0" max="-1"/>
            <bind match="dataRef" ref="$.IT_ITEMS.DATA[*]"/>
            <border>
               <edge presence="hidden"/>
               <edge presence="hidden"/>
               <edge thickness="0.1mm">
                  <color value="200,200,200"/>
               </edge>
               <edge presence="hidden"/>
            </border>
            <field name="BOOKING_ID" h="6.5mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                     <margin/>
                  </textEdit>
               </ui>
               <font typeface="Arial" size="9pt"/>
               <margin leftInset="1.5mm" rightInset="1.5mm"/>
               <para vAlign="middle"/>
               <bind match="dataRef" ref="$.BOOKING_ID"/>
            </field>
            <field name="FLIGHT_DATE" h="6.5mm">
               <ui>
                  <dateTimeEdit>
                     <border presence="hidden"/>
                     <margin/>
                  </dateTimeEdit>
               </ui>
               <font typeface="Arial" size="9pt"/>
