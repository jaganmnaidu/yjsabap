               <margin leftInset="1.5mm" rightInset="1.5mm"/>
               <para vAlign="middle"/>
               <bind match="dataRef" ref="$.CARRIER_NAME"/>
            </field>
            <field name="FLIGHT_NO" h="6.5mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                     <margin/>
                  </textEdit>
               </ui>
               <font typeface="Arial" size="9pt"/>
               <margin leftInset="1.5mm" rightInset="1.5mm"/>
               <para vAlign="middle"/>
               <bind match="dataRef" ref="$.FLIGHT_NO"/>
            </field>
            <field name="ROUTE" h="6.5mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                     <margin/>
                  </textEdit>
               </ui>
               <font typeface="Arial" size="9pt"/>
               <margin leftInset="1.5mm" rightInset="1.5mm"/>
