      <draw name="PaymentNote" w="180mm" h="10mm">
         <ui>
            <textEdit/>
         </ui>
         <value>
            <text>Payment is due within 14 days of the invoice date. Booking prices are shown in the airline's currency; totals include supplements and are converted to the invoice currency.</text>
         </value>
         <font typeface="Arial" size="8pt">
            <fill>
               <color value="110,110,110"/>
            </fill>
         </font>
         <para vAlign="top"/>
      </draw>
