         </field>
         <draw name="TotalLine" x="90mm" y="17mm" w="90mm" h="0mm">
            <value>
               <line>
                  <edge thickness="0.3mm">
                     <color value="31,56,100"/>
                  </edge>
               </line>
            </value>
         </draw>
         <field name="TOTAL_AMOUNT" x="90mm" y="19mm" w="68mm" h="7mm">
            <ui>
               <numericEdit>
                  <border presence="hidden"/>
                  <margin/>
               </numericEdit>
            </ui>
            <font typeface="Arial" size="11pt" weight="bold"/>
            <para hAlign="right" vAlign="middle"/>
            <caption reserve="40mm">
               <font typeface="Arial" size="11pt" weight="bold"/>
               <para vAlign="middle"/>
               <value>
                  <text>Total amount</text>
               </value>
            </caption>
            <value>
               <decimal fracDigits="2"/>
            </value>
            <format>
               <picture>num{z,zzz,zzz,zz9.99}</picture>
            </format>
            <bind match="dataRef" ref="$.IS_HEADER.TOTAL_AMOUNT"/>
         </field>
         <field name="CurrencyTotal" x="159.5mm" y="19mm" w="20mm" h="7mm">
            <ui>
               <textEdit>
                  <border presence="hidden"/>
                  <margin/>
               </textEdit>
            </ui>
            <font typeface="Arial" size="11pt" weight="bold"/>
