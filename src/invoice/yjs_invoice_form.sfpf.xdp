      <!-- ===================== Totals ===================== -->
      <subform name="Totals" layout="position" w="180mm" h="28mm">
         <bind match="none"/>
         <field name="BOOKING_FEE" x="90mm" y="4mm" w="68mm" h="5.5mm">
            <ui>
               <numericEdit>
                  <border presence="hidden"/>
                  <margin/>
               </numericEdit>
            </ui>
            <font typeface="Arial" size="9pt"/>
            <para hAlign="right" vAlign="middle"/>
            <caption reserve="40mm">
               <font typeface="Arial" size="9pt"/>
               <para vAlign="middle"/>
               <value>
                  <text>Booking fee</text>
               </value>
            </caption>
            <value>
               <decimal fracDigits="2"/>
